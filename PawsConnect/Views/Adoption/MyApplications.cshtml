@model PawsConnect.ViewModels.AdoptionApplicationListViewModel

@{
    ViewData["Title"] = "My Applications";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="display-5 fw-bold">My Applications</h1>
        <p class="lead text-muted">
            Track the adoption applications you have submitted.
        </p>
    </div>

    @if (!Model.Applications.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div style="font-size: 3rem;">🐾</div>

                <h3>No applications yet</h3>

                <p class="text-muted">
                    You have not submitted any adoption applications.
                </p>

                <a asp-controller="Dogs"
                   asp-action="Index"
                   class="btn btn-primary">
                    Find a Dog
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var application in Model.Applications)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h3 class="h4">
                                @application.Dog?.Name
                            </h3>

                            <p class="text-muted mb-3">
                                @application.Dog?.Breed
                            </p>

                            <p class="mb-2">
                                <strong>Application Number:</strong>
                                #@application.AdoptionApplicationId
                            </p>

                            <p class="mb-3">
                                <strong>Submitted:</strong>
                                @application.SubmittedAt.ToLocalTime().ToString("dd MMMM yyyy")
                            </p>

                            @if (application.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (application.Status == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @application.Status
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>