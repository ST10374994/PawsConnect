@model PawsConnect.ViewModels.CreateAdoptionApplicationViewModel

@{
    ViewData["Title"] = "Apply to Adopt";
    var dog = ViewBag.Dog as PawsConnect.Models.Dog;
}

<section class="page-header">
    <div class="container">
        <span class="section-label">PAWSCONNECT ADOPTION</span>

        <h1>Apply to Adopt</h1>

        <p>
            Tell us about yourself and why you would like to
            give this dog a loving forever home.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="auth-card">

                    <div class="text-center mb-4">
                        <div class="auth-icon">❤️</div>

                        <h2>
                            Application for @dog?.Name
                        </h2>

                        <p class="text-muted">
                            Please complete all required fields.
                        </p>
                    </div>

                    <form asp-action="Create"
                          method="post">

                        <input asp-for="DogId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter your home address"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone"
                                   class="form-label">
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="e.g. 082 123 4567" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ReasonForAdoption"
                                   class="form-label">
                            </label>

                            <textarea asp-for="ReasonForAdoption"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Explain why you would like to adopt this dog..."></textarea>

                            <span asp-validation-for="ReasonForAdoption"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="HasOtherPets"
                                   class="form-check-input" />

                            <label asp-for="HasOtherPets"
                                   class="form-check-label">
                            </label>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Experience"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Experience"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Tell us about your experience with pets..."></textarea>

                            <span asp-validation-for="Experience"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Application
                            </button>

                            <a asp-controller="Dogs"
                               asp-action="Details"
                               asp-route-id="@Model.DogId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}