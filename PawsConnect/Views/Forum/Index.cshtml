@model PawsConnect.ViewModels.ForumPostListViewModel

@{
    ViewData["Title"] = "Community";
}

<section class="page-header">
    <div class="container">
        <span class="section-label">
            PAWSCONNECT COMMUNITY
        </span>

        <h1>Rescue Community</h1>

        <p>
            Connect with other animal lovers, share adoption
            experiences, and discuss responsible pet ownership.
        </p>
    </div>
</section>

<section class="forum-section">
    <div class="container">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <div>
                <h2>Community Forum</h2>
                <p class="text-muted mb-0">
                    Ask questions and share your experiences.
                </p>
            </div>

            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated)
            {
                <a asp-controller="Forum"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Post
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary">
                    Login to Post
                </a>
            }

        </div>

        @if (Model.Posts.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="feature-icon">
                        💬
                    </div>

                    <h3>No posts yet</h3>

                    <p class="text-muted">
                        Be the first person to start a discussion.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var post in Model.Posts)
                {
                    <div class="col-12">

                        <div class="card shadow-sm">
                            <div class="card-body p-4">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-3">

                                    <div>
                                        <h3 class="h4 mb-2">
                                            <a asp-controller="Forum"
                                               asp-action="Details"
                                               asp-route-id="@post.PostId"
                                               class="text-decoration-none">
                                                @post.Title
                                            </a>
                                        </h3>

                                        <p class="text-muted mb-3">
                                            Posted by
                                            @post.User?.FirstName
                                            @post.User?.LastName
                                            on @post.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")
                                        </p>
                                    </div>

                                    <span class="badge bg-success">
                                        @post.Status
                                    </span>

                                </div>

                                <p class="mb-3">
                                    @post.Content
                                </p>

                                <hr />

                                <small class="text-muted">
                                    @post.Replies.Count
                                    @(post.Replies.Count == 1
                                        ? "reply"
                                        : "replies")
                                </small>

                            </div>
                        </div>

                    </div>
                }

            </div>
        }

    </div>
</section>